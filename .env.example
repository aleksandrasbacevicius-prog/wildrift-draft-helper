ANTHROPIC_API_KEY=your-key-here

# One access token per person, as name:token pairs. Generate them with:
#   python -m wildrift.tokens alex sam jonas
# Leave empty to use the app only on this computer.
APP_TOKENS=

# Custom (AI) builds per person per window, plus a total cap across everyone
AI_BUILD_LIMIT=5
AI_GLOBAL_LIMIT=30
AI_WINDOW_HOURS=48
